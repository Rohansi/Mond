{
  "name": "mond-vscode",
  "displayName": "Mond",
  "version": "0.0.5",
  "publisher": "Rohansi",
  "description": "Language support for the Mond scripting language",
  "author": {
    "name": "Rohans",
    "email": "rohan-singh@hotmail.com"
  },
  "license": "MIT",
  "keywords": [
    "mond",
    "mnd",
    "scripting",
    "language",
    "debugger",
    "multi-root ready"
  ],
  "engines": {
    "vscode": "^1.97.0"
  },
  "icon": "images/mond-icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Snippets"
  ],
  "homepage": "https://github.com/Rohansi/Mond/tree/master/Mond.VSCode",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rohansi/Mond.git",
    "directory": "Mond.VSCode"
  },
  "bugs": {
    "url": "https://github.com/Rohansi/Mond/issues"
  },
  "scripts": {
    "vscode:prepublish": "npm run package-ext",
    "compile": "tsc -p ./",
    "check-types": "tsc -p ./ --noEmit",
    "lint": "eslint src/",
    "bundle": "node build/esbuild.mjs",
    "package-ext": "node build/esbuild.mjs --production",
    "watch": "node build/esbuild.mjs --watch",
    "watch-types": "tsc -watch -p ./",
    "build-repl": "node build/buildRepl.mjs",
    "pretest": "npm run compile && npm run bundle && npm run lint && npm run build-repl",
    "test": "vscode-test",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "isomorphic-ws": "^5.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.6",
    "utf-8-validate": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.2",
    "@types/vscode": "^1.97.0",
    "@types/ws": "^8.5.14",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "mocha": "^11.7.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "main": "./dist/ext/extension.js",
  "activationEvents": [
    "onDebugResolve:mond"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Running and debugging Mond scripts requires access to the local file system."
    }
  },
  "contributes": {
    "configuration": [
      {
        "title": "Mond",
        "type": "object",
        "properties": {
          "mond.replPath": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "markdownDescription": "Path to the Mond REPL executable used to run and debug scripts. When empty, the extension looks for `mond` on your `PATH` and then for the `Mond.Repl` dotnet tool. Supports the `${workspaceFolder}` and `${userHome}` variables."
          },
          "mond.standardLibraries.enableCompletion": {
            "type": "boolean",
            "default": true,
            "description": "Enable completion for symbols from the Mond standard library"
          }
        }
      }
    ],
    "languages": [
      {
        "id": "mond",
        "aliases": [
          "Mond",
          "mond"
        ],
        "extensions": [
          ".mnd"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mond",
        "scopeName": "source.mond",
        "path": "./syntaxes/mond.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mond",
        "path": "./snippets/mond-snippets.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "extension.mond.runEditorContents",
          "when": "resourceLangId == mond",
          "group": "1_run@10"
        },
        {
          "command": "extension.mond.debugEditorContents",
          "when": "resourceLangId == mond",
          "group": "1_run@20"
        }
      ],
      "commandPalette": [
        {
          "command": "extension.mond.debugEditorContents",
          "when": "resourceLangId == mond"
        },
        {
          "command": "extension.mond.runEditorContents",
          "when": "resourceLangId == mond"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.mond.debugEditorContents",
        "title": "Debug File",
        "category": "Mond",
        "enablement": "!inDebugMode",
        "icon": "$(debug-alt)"
      },
      {
        "command": "extension.mond.runEditorContents",
        "title": "Run File",
        "category": "Mond",
        "enablement": "!inDebugMode",
        "icon": "$(play)"
      }
    ],
    "breakpoints": [
      {
        "language": "mond"
      }
    ],
    "debuggers": [
      {
        "type": "mond",
        "label": "Mond",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to a text file.",
                "default": "${workspaceFolder}/main.mnd"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launch.",
                "default": true
              },
              "trace": {
                "type": "boolean",
                "description": "Enable logging of the Debug Adapter Protocol.",
                "default": true
              }
            }
          },
          "attach": {
            "required": [
              "endpoint"
            ],
            "properties": {
              "endpoint": {
                "type": "string",
                "description": "WebSocket endpoint the debugger is running on.",
                "default": "ws://127.0.0.1:1597"
              },
              "trace": {
                "type": "boolean",
                "description": "Enable logging of the Debug Adapter Protocol.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [],
        "configurationSnippets": [
          {
            "label": "Mond: Launch",
            "description": "A new configuration for debugging a Mond script.",
            "body": {
              "name": "Run Mond script",
              "request": "launch",
              "type": "mond",
              "program": "^\"\\${workspaceFolder}/\\${file}\"",
              "stopOnEntry": true
            }
          },
          {
            "label": "Mond: Attach",
            "description": "A new configuration for debugging a running Mond process.",
            "body": {
              "name": "Attach to Mond process",
              "request": "attach",
              "type": "mond",
              "endpoint": "^\"ws://127.0.0.1:1597\""
            }
          }
        ]
      }
    ]
  }
}
