{
    "comments": {
        // symbol used for single line comment. Remove this entry if your language does not support line comments
        "lineComment": "//",
        // symbols used for start and end a block comment. Remove this entry if your language does not support block comments
        "blockComment": [ "/*", "*/" ]
    },
    // symbols used as brackets
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "colorizedBracketPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": [ "string", "comment" ] },
        { "open": "'", "close": "'", "notIn": [ "string", "comment" ] },
        { "open": "/*", "close": " */", "notIn": [ "string" ] }
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    // only auto close when the next character can't continue the expression
    "autoCloseBefore": ";:.,=}])> \n\t",
    // identifiers, or numbers with an optional fractional part
    "wordPattern": "(-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)|([A-Za-z_][0-9A-Za-z_]*)",
    "indentationRules": {
        // a line ending in an unclosed {, [ or ( indents the next one
        "increaseIndentPattern": "^((?!//).)*(\\{[^}\"']*|\\([^)\"']*|\\[[^\\]\"']*)$",
        // a line starting with a closer outdents itself
        "decreaseIndentPattern": "^((?!.*?/\\*).*\\*/)?\\s*[}\\])].*$"
    },
    "onEnterRules": [
        {
            // /** | */ - expand the block comment and leave the cursor inside
            "beforeText": "^\\s*/\\*\\*(?!/)([^*]|\\*(?!/))*$",
            "afterText": "^\\s*\\*/$",
            "action": { "indent": "indentOutdent", "appendText": " * " }
        },
        {
            // /** | - continue a doc comment
            "beforeText": "^\\s*/\\*\\*(?!/)([^*]|\\*(?!/))*$",
            "action": { "indent": "none", "appendText": " * " }
        },
        {
            // /* | - continue a block comment
            "beforeText": "^\\s*/\\*(?!\\*)([^*]|\\*(?!/))*$",
            "action": { "indent": "none", "appendText": " * " }
        },
        {
            // * | - continue the body of a block comment
            "beforeText": "^(\\t|[ ])*[ ]\\*([ ]([^*]|\\*(?!/))*)?$",
            "previousLineText": "(?=^(\\s*(/\\*\\*|\\*)).*)(?=(?!(\\s*\\*/)))",
            "action": { "indent": "none", "appendText": "* " }
        },
        {
            // */ | - stop continuing the comment
            "beforeText": "^(\\t|[ ])*[ ]\\*/\\s*$",
            "action": { "indent": "none", "removeText": 1 }
        }
    ],
    "folding": {
        "markers": {
            "start": "^\\s*//\\s*#?region\\b",
            "end": "^\\s*//\\s*#?endregion\\b"
        }
    }
}